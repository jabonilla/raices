    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"

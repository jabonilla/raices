# Postgres connection string for the API and for `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raices

# Optional. When set, the Testcontainers helper in tests/pg.ts uses this
# existing Postgres 16 instead of starting a container. Use it only where
# Docker is unavailable; CI leaves it unset so tests run against a container.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5433/postgres

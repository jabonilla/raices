# Postgres connection string for the API and for `pnpm db:migrate`.
# REQUIRED in production: the API refuses to boot without it (validated in
# apps/api/src/index.ts). /ready reports 503 until Postgres is reachable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raices

# Optional. When set, the Testcontainers helper in tests/pg.ts uses this
# existing Postgres 16 instead of starting a container. Use it only where
# Docker is unavailable; CI leaves it unset so tests run against a container.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5433/postgres

# --- Production (Railway / Docker) ---
# Port the API listens on. Defaults to 3000. Railway injects PORT
# automatically; the Dockerfile EXPOSEs 3000.
# PORT=3000

# NODE_ENV=production is set by the Dockerfile. It switches pino to JSON
# logging at info level (pretty/debug otherwise).
# NODE_ENV=production

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-native"
  },
  "include": [
    "apps/**/src/**/*.ts",
    "apps/**/test/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "apps/**/src/**/*.tsx",
    "apps/**/test/**/*.tsx",
    "apps/**/app/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
